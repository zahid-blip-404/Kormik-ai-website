---
import { tradeIcons } from '../lib/trade-icons';
interface Props { name: string; size?: number | string }
const { name, size = 24 } = Astro.props;
const icon = tradeIcons[name] ?? tradeIcons.toolbox;
---
<span class="k-trade-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width={size} height={size} fill="currentColor" stroke="none" aria-hidden="true" set:html={icon.svg}></svg></span>
