<div aria-hidden="true" style="position: absolute; right: -40px; top: -24px; width: 200px; aspect-ratio: 502 / 689; background: rgb(27, 29, 122); mask-image: url(/images/fingerprint.webp); mask-size: contain; mask-repeat: no-repeat;"></div>
