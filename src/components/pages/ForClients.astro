---
// Generated from the Claude Design export by design/tools/gen.py (for-clients). Edit the strings in
// design/tools/strings/for-clients.json and re-run the generator rather than editing this file by hand.
import { makeL, localize, type Lang } from '../../lib/i18n';
import EarlyAccessForm from '../EarlyAccessForm.astro';
import TradeIcon from '../TradeIcon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = makeL(lang);
const href = (p: string) => localize(p, lang);
---
<main data-page="for-clients"><section data-screen-label="Hero" data-theme="light" style="background: var(--paper); padding-block: 64px;">
<div class="k-container">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px 56px; align-items: center;">
<div style="display: flex; flex-direction: column; gap: 20px; min-width: 0px;">
<p class="label" style="margin: 0px; color: var(--ink-muted);">{L("For clients · Pre-launch preview", "ক্লায়েন্টদের জন্য · চালুর আগের প্রিভিউ")}</p>
<h1 style='margin: 0px; font: 700 clamp(34px, 3.6vw, 52px) / 1.08 Ubuntu, "Trebuchet MS", sans-serif; letter-spacing: -1.2px; color: var(--indigo);'>{L("Need a crew?", "দল দরকার?")} <span style="color: var(--orange-ink);">{L("Hire people you can trust.", "বিশ্বস্ত মানুষ নিন।")}</span></h1>
<p class="body-lg" style="margin: 0px; color: var(--ink); max-width: 48ch;">{L("The worker gets a record. The client gets a crew they can trust. From a leaking bathroom to a public road.", "কর্মী পান একটি রেকর্ড। ক্লায়েন্ট পান ভরসা করার মতো একটি দল। চুইয়ে পড়া বাথরুম থেকে সরকারি রাস্তা পর্যন্ত।")}</p>
<div style="display: flex; flex-wrap: wrap; gap: 12px; padding-top: 4px;">
<a class="k-btn k-btn--primary k-btn--lg" href="#early-access">{L("I need a crew", "আমার দল দরকার")}<span aria-hidden="true" class="k-btn__arrow">→</span></a>
<a class="k-btn k-btn--secondary k-btn--lg" href="#public-works">{L("Public works", "সরকারি কাজ")}</a>
</div>
</div>
<div style="display: grid; grid-template-columns: minmax(0px, 1.35fr) minmax(0px, 1fr); grid-template-rows: 210px 210px; gap: 12px; min-width: 0px;">
<div style="grid-row: 1 / 3; border-radius: 4px; overflow: hidden; background: var(--slot);"><img alt={L("A crew in hard hats and high-visibility vests at work on a construction site", "নির্মাণ সাইটে হেলমেট ও উজ্জ্বল জ্যাকেট পরা একটি দল কাজ করছে")} src="/images/pexels-4956918-w900.webp" style="width: 100%; height: 100%; object-fit: cover; object-position: center center; display: block;"/></div>
<div style="border-radius: 4px; overflow: hidden; background: var(--slot);"><img alt={L("An electrician working on a building's power lines from a ladder", "মই থেকে একটি ভবনের বিদ্যুৎ লাইনে কাজ করছেন একজন ইলেকট্রিশিয়ান")} src="/images/pexels-14934023-w900.webp" style="width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block;"/></div>
<div style="border-radius: 4px; overflow: hidden; background: var(--slot);"><img alt={L("A worker in a trench at a construction site", "নির্মাণ সাইটে খাদের ভেতরে একজন কর্মী")} src="/images/pexels-15099463-w900.webp" style="width: 100%; height: 100%; object-fit: cover; object-position: center center; display: block;"/></div>
</div>
</div>
</div></section><section data-screen-label="Who can hire" data-theme="light" style="background: rgb(255, 255, 255); padding-block: 72px;">
<div class="k-container">
<h2 style='margin: 0px 0px 36px; font: 700 clamp(30px, 3vw, 42px) / 1.1 Ubuntu, "Trebuchet MS", sans-serif; letter-spacing: -1px; color: var(--indigo); text-align: center;'>{L("Who can hire through Kormik", "কর্মীকের মাধ্যমে কারা লোক নিতে পারবেন")}</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 28px 32px;">
<div style="border-top: 2px solid var(--indigo); padding-top: 18px; display: flex; flex-direction: column; gap: 8px;"><h3 class="heading-4" style="margin: 0px; color: var(--indigo); font-size: 22px;">{L("Homes", "বাড়ি")}</h3><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("A repair, a repaint, a new bathroom.", "একটি মেরামত, নতুন রং, নতুন বাথরুম।")}</p></div>
<div style="border-top: 2px solid var(--indigo); padding-top: 18px; display: flex; flex-direction: column; gap: 8px;"><h3 class="heading-4" style="margin: 0px; color: var(--indigo); font-size: 22px;">{L("Shops and businesses", "দোকান ও ব্যবসা")}</h3><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("Fit-outs, upkeep and loading, done by a known crew.", "সাজসজ্জা, রক্ষণাবেক্ষণ আর মালামাল তোলা-নামানো, চেনা দলের হাতে।")}</p></div>
<div style="border-top: 2px solid var(--indigo); padding-top: 18px; display: flex; flex-direction: column; gap: 8px;"><h3 class="heading-4" style="margin: 0px; color: var(--indigo); font-size: 22px;">{L("Contractors and developers", "ঠিকাদার ও ডেভেলপার")}</h3><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("Skilled crews for every stage of a build.", "নির্মাণের প্রতিটি ধাপের জন্য দক্ষ দল।")}</p></div>
<div style="border-top: 2px solid var(--orange); padding-top: 18px; display: flex; flex-direction: column; gap: 8px;"><h3 class="heading-4" style="margin: 0px; color: var(--indigo); font-size: 22px;">{L("Government and public works", "সরকারি ও গণপূর্ত কাজ")}</h3><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("Crews for work that runs on tenders, notices and bidding.", "টেন্ডার, নোটিশ ও দরপত্রের কাজের জন্য দল।")}</p></div>
</div>
</div></section><section data-screen-label="Trades" data-theme="light" style="background: var(--paper); padding-block: 72px;">
<div class="k-container">
<h2 style='margin: 0px 0px 8px; font: 700 clamp(30px, 3vw, 42px) / 1.1 Ubuntu, "Trebuchet MS", sans-serif; letter-spacing: -1px; color: var(--indigo); text-align: center;'>{L("From a leaking bathroom to a public road.", "চুইয়ে পড়া বাথরুম থেকে সরকারি রাস্তা পর্যন্ত।")}</h2>
<p class="body-lg" style="margin: 0px 0px 32px; color: var(--ink-muted); text-align: center;">{L("The trades Kormik crews will cover.", "কর্মীকের দলগুলো যেসব কাজ করবে।")}</p>
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px;">
<div style="background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: flex; gap: 14px; align-items: center; color: var(--indigo); min-height: 64px; box-sizing: border-box;">
<TradeIcon name="trowel" size={28} />
<div style="min-width: 0px;"><p class="body" style="margin: 0px; font-weight: 700; color: var(--indigo);"><span class="sc-interp">{L("Masonry", "রাজমিস্ত্রি")}</span></p><p lang="bn" style='margin: 0px; font: 500 15px / 1.5 "Anek Bangla", sans-serif; color: var(--orange-ink);'><span class="sc-interp">রাজমিস্ত্রি</span></p></div>
</div>
<div style="background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: flex; gap: 14px; align-items: center; color: var(--indigo); min-height: 64px; box-sizing: border-box;">
<TradeIcon name="snips" size={28} />
<div style="min-width: 0px;"><p class="body" style="margin: 0px; font-weight: 700; color: var(--indigo);"><span class="sc-interp">{L("Rod binding", "রড বাঁধাই")}</span></p><p lang="bn" style='margin: 0px; font: 500 15px / 1.5 "Anek Bangla", sans-serif; color: var(--orange-ink);'><span class="sc-interp">রড বাঁধাই</span></p></div>
</div>
<div style="background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: flex; gap: 14px; align-items: center; color: var(--indigo); min-height: 64px; box-sizing: border-box;">
<TradeIcon name="roller" size={28} />
<div style="min-width: 0px;"><p class="body" style="margin: 0px; font-weight: 700; color: var(--indigo);"><span class="sc-interp">{L("Painting", "রং করা")}</span></p><p lang="bn" style='margin: 0px; font: 500 15px / 1.5 "Anek Bangla", sans-serif; color: var(--orange-ink);'><span class="sc-interp">রং করা</span></p></div>
</div>
<div style="background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: flex; gap: 14px; align-items: center; color: var(--indigo); min-height: 64px; box-sizing: border-box;">
<TradeIcon name="bolt" size={28} />
<div style="min-width: 0px;"><p class="body" style="margin: 0px; font-weight: 700; color: var(--indigo);"><span class="sc-interp">{L("Electrical", "ইলেকট্রিক")}</span></p><p lang="bn" style='margin: 0px; font: 500 15px / 1.5 "Anek Bangla", sans-serif; color: var(--orange-ink);'><span class="sc-interp">ইলেকট্রিক</span></p></div>
</div>
<div style="background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: flex; gap: 14px; align-items: center; color: var(--indigo); min-height: 64px; box-sizing: border-box;">
<TradeIcon name="plunger" size={28} />
<div style="min-width: 0px;"><p class="body" style="margin: 0px; font-weight: 700; color: var(--indigo);"><span class="sc-interp">{L("Plumbing", "প্লাম্বিং")}</span></p><p lang="bn" style='margin: 0px; font: 500 15px / 1.5 "Anek Bangla", sans-serif; color: var(--orange-ink);'><span class="sc-interp">প্লাম্বিং</span></p></div>
</div>
<div style="background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: flex; gap: 14px; align-items: center; color: var(--indigo); min-height: 64px; box-sizing: border-box;">
<TradeIcon name="tile" size={28} />
<div style="min-width: 0px;"><p class="body" style="margin: 0px; font-weight: 700; color: var(--indigo);"><span class="sc-interp">{L("Tiles and flooring", "টাইলস ও মেঝে")}</span></p><p lang="bn" style='margin: 0px; font: 500 15px / 1.5 "Anek Bangla", sans-serif; color: var(--orange-ink);'><span class="sc-interp">টাইলস ও মেঝে</span></p></div>
</div>
<div style="background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: flex; gap: 14px; align-items: center; color: var(--indigo); min-height: 64px; box-sizing: border-box;">
<TradeIcon name="saw" size={28} />
<div style="min-width: 0px;"><p class="body" style="margin: 0px; font-weight: 700; color: var(--indigo);"><span class="sc-interp">{L("Carpentry", "কাঠমিস্ত্রি")}</span></p><p lang="bn" style='margin: 0px; font: 500 15px / 1.5 "Anek Bangla", sans-serif; color: var(--orange-ink);'><span class="sc-interp">কাঠমিস্ত্রি</span></p></div>
</div>
<div style="background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: flex; gap: 14px; align-items: center; color: var(--indigo); min-height: 64px; box-sizing: border-box;">
<TradeIcon name="shovel" size={28} />
<div style="min-width: 0px;"><p class="body" style="margin: 0px; font-weight: 700; color: var(--indigo);"><span class="sc-interp">{L("Helpers and site labour", "সহকারী ও জোগালি")}</span></p><p lang="bn" style='margin: 0px; font: 500 15px / 1.5 "Anek Bangla", sans-serif; color: var(--orange-ink);'><span class="sc-interp">সহকারী ও জোগালি</span></p></div>
</div>
<div style="background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: flex; gap: 14px; align-items: center; color: var(--indigo); min-height: 64px; box-sizing: border-box;">
<TradeIcon name="broom" size={28} />
<div style="min-width: 0px;"><p class="body" style="margin: 0px; font-weight: 700; color: var(--indigo);"><span class="sc-interp">{L("Cleaning", "পরিচ্ছন্নতা")}</span></p><p lang="bn" style='margin: 0px; font: 500 15px / 1.5 "Anek Bangla", sans-serif; color: var(--orange-ink);'><span class="sc-interp">পরিচ্ছন্নতা</span></p></div>
</div>
<div style="background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: flex; gap: 14px; align-items: center; color: var(--indigo); min-height: 64px; box-sizing: border-box;">
<TradeIcon name="box" size={28} />
<div style="min-width: 0px;"><p class="body" style="margin: 0px; font-weight: 700; color: var(--indigo);"><span class="sc-interp">{L("Loading and shifting", "মালামাল বহন")}</span></p><p lang="bn" style='margin: 0px; font: 500 15px / 1.5 "Anek Bangla", sans-serif; color: var(--orange-ink);'><span class="sc-interp">মালামাল বহন</span></p></div>
</div>
<div style="background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: flex; gap: 14px; align-items: center; color: var(--indigo); min-height: 64px; box-sizing: border-box;">
<TradeIcon name="toolbox" size={28} />
<div style="min-width: 0px;"><p class="body" style="margin: 0px; font-weight: 700; color: var(--indigo);"><span class="sc-interp">{L("Home repairs", "ঘরের মেরামত")}</span></p><p lang="bn" style='margin: 0px; font: 500 15px / 1.5 "Anek Bangla", sans-serif; color: var(--orange-ink);'><span class="sc-interp">ঘরের মেরামত</span></p></div>
</div>
<div style="background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: flex; gap: 14px; align-items: center; color: var(--indigo); min-height: 64px; box-sizing: border-box;">
<TradeIcon name="pickaxe" size={28} />
<div style="min-width: 0px;"><p class="body" style="margin: 0px; font-weight: 700; color: var(--indigo);"><span class="sc-interp">{L("Earthworks and roads", "মাটি ও রাস্তার কাজ")}</span></p><p lang="bn" style='margin: 0px; font: 500 15px / 1.5 "Anek Bangla", sans-serif; color: var(--orange-ink);'><span class="sc-interp">মাটি ও রাস্তার কাজ</span></p></div>
</div>
</div>
<p class="small" style="margin: 16px 0px 0px; color: var(--ink-muted); text-align: center;">{L("Bangla trade names to be checked by a native speaker.", "কাজের বাংলা নামগুলো একজন মাতৃভাষী যাচাই করবেন।")}</p>
</div></section><section data-screen-label="What you can count on" data-theme="light" style="background: rgb(255, 255, 255); padding-block: 72px;">
<div class="k-container">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px 64px; align-items: center;">
<div style="display: flex; flex-direction: column; gap: 24px;">
<h2 style='margin: 0px; font: 700 clamp(30px, 3vw, 42px) / 1.1 Ubuntu, "Trebuchet MS", sans-serif; letter-spacing: -1px; color: var(--indigo);'>{L("What you can count on", "যার ওপর ভরসা রাখতে পারেন")}</h2>
<div style="display: flex; flex-direction: column; gap: 20px;">
<div style="border-top: 1px solid var(--line); padding-top: 16px; display: grid; grid-template-columns: 40px 1fr; gap: 16px;"><span style="font: 700 24px / 1 Ubuntu, sans-serif; color: var(--orange-ink);">{L("01", "০১")}</span><div><h3 class="heading-4" style="margin: 0px 0px 6px; color: var(--indigo); font-size: 20px;">{L("A Team Leader who answers for the crew", "দলের দায় নেন একজন টিম লিডার")}</h3><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("One person you can call, who knows every worker on your job.", "একজনকে ফোন করলেই হবে, যিনি আপনার কাজের প্রত্যেক কর্মীকে চেনেন।")}</p></div></div>
<div style="border-top: 1px solid var(--line); padding-top: 16px; display: grid; grid-template-columns: 40px 1fr; gap: 16px;"><span style="font: 700 24px / 1 Ubuntu, sans-serif; color: var(--orange-ink);">{L("02", "০২")}</span><div><h3 class="heading-4" style="margin: 0px 0px 6px; color: var(--indigo); font-size: 20px;">{L("The right skills, with a record of past work", "সঠিক দক্ষতা, আগের কাজের রেকর্ডসহ")}</h3><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("Each worker comes with a record of the work they have done before.", "প্রত্যেক কর্মীর সঙ্গে থাকে তার আগের কাজের রেকর্ড।")}</p></div></div>
<div style="border-top: 1px solid var(--line); padding-top: 16px; display: grid; grid-template-columns: 40px 1fr; gap: 16px;"><span style="font: 700 24px / 1 Ubuntu, sans-serif; color: var(--orange-ink);">{L("03", "০৩")}</span><div><h3 class="heading-4" style="margin: 0px 0px 6px; color: var(--indigo); font-size: 20px;">{L("Every day of work on record", "প্রতিটি কাজের দিন রেকর্ডে")}</h3><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("A clear record of who worked on your job, ready when a tender or contractor asks for it.", "কারা আপনার কাজ করেছেন তার স্পষ্ট রেকর্ড, টেন্ডার বা ঠিকাদার চাইলেই হাতে।")}</p></div></div>
</div>
</div>
<div style="display: flex; justify-content: center; min-width: 0px;">
<div style='display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 28px; font-family: "Helvetica Neue", Helvetica, Arimo, Arial, sans-serif;'>
<div style="display: flex; flex-direction: column; gap: 10px; flex: 1 1 280px; max-width: 360px; min-width: 0px;">
