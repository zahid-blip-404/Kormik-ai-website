---
// Generated from the Claude Design export by design/tools/gen.py (about). Edit the strings in
// design/tools/strings/about.json and re-run the generator rather than editing this file by hand.
import { makeL, localize, type Lang } from '../../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = makeL(lang);
const href = (p: string) => localize(p, lang);
---
<main data-page="about"><section data-screen-label="The name" data-theme="light" style="background: var(--paper); padding-block: 64px; overflow: hidden;">
<div class="k-container">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px 64px; align-items: center;">
<div style="min-width: 0px;">
<p lang="bn" style='margin: 0px; font: 700 clamp(140px, 17vw, 260px) / 1.1 "Anek Bangla", sans-serif; color: var(--indigo); letter-spacing: -4px;'>কর্মী</p>
<p style="margin: 0px; font: 500 clamp(22px, 2vw, 28px) / 1.3 Ubuntu, sans-serif; color: var(--ink-muted);"><span style="color: var(--orange-ink);">{L("kormi", "কর্মী")}</span> {L("· \"worker\"", "· \"যিনি কাজ করেন\"")}</p>
</div>
<div style="display: flex; flex-direction: column; gap: 18px;">
<p class="label" style="margin: 0px; color: var(--ink-muted);">{L("About Kormik", "কর্মীক সম্পর্কে")}</p>
<h1 style='margin: 0px; font: 700 clamp(32px, 3.2vw, 46px) / 1.1 Ubuntu, "Trebuchet MS", sans-serif; letter-spacing: -1.2px; color: var(--indigo);'>{L("Kormik is named for the people who do the work.", "কর্মীক নামটি তাদের নামে, যারা কাজটি করেন।")}</h1>
<p class="body-lg" style="margin: 0px; color: var(--ink);">{L("Masons, painters, electricians, helpers, loaders. The people who build Bangladesh, and who have never had a record of it.", "রাজমিস্ত্রি, রং মিস্ত্রি, ইলেকট্রিশিয়ান, জোগালি, মালামাল বহনকারী। যারা বাংলাদেশ গড়েন, অথচ যাদের কাজের কোনো রেকর্ড কখনো ছিল না।")}</p>
</div>
</div>
</div></section><section data-screen-label="Mission" data-theme="indigo" style="background: var(--indigo); color: rgb(255, 255, 255); padding-block: 88px;">
<div class="k-container" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px;">
<p class="label" style="margin: 0px; color: var(--lavender);">{L("Our mission", "আমাদের লক্ষ্য")}</p>
<h2 style='margin: 0px; font: 700 clamp(32px, 3.8vw, 56px) / 1.08 Ubuntu, "Trebuchet MS", sans-serif; letter-spacing: -1.4px; color: rgb(255, 255, 255);'>{L("Every day of informal work in Bangladesh,", "বাংলাদেশের প্রতিটি অনানুষ্ঠানিক কাজের দিন,")} <span style="color: var(--orange);">{L("recognised, paid and protected.", "স্বীকৃত, পারিশ্রমিকপ্রাপ্ত ও সুরক্ষিত।")}</span></h2>
</div></section><section data-screen-label="Who we build for" data-theme="light" style="background: rgb(255, 255, 255); padding-block: 72px;">
<div class="k-container">
<h2 style='margin: 0px 0px 36px; font: 700 clamp(30px, 3vw, 42px) / 1.1 Ubuntu, "Trebuchet MS", sans-serif; letter-spacing: -1px; color: var(--indigo); text-align: center;'>{L("Who we're building for", "আমরা যাদের জন্য গড়ছি")}</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px 24px;">
<div style="display: flex; flex-direction: column; gap: 12px;"><div style="aspect-ratio: 4 / 3; border-radius: 4px; overflow: hidden; background: var(--slot);"><img alt={L("A construction worker in a safety vest and headscarf holding a spade", "নিরাপত্তা জ্যাকেট ও মাথায় কাপড় বাঁধা একজন নির্মাণকর্মী, হাতে কোদাল")} src="/images/pexels-37556467-w900.webp" style="width: 100%; height: 100%; object-fit: cover; object-position: center 25%; display: block;"/></div><h3 class="heading-4" style="margin: 0px; color: var(--indigo); font-size: 22px;">{L("Workers", "কর্মী")} <span lang="bn" style='font-family: "Anek Bangla", sans-serif; color: var(--orange-ink); font-weight: 500;'>কর্মী</span></h3><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("Your work, on record.", "আপনার কাজ, রেকর্ডে।")}</p></div>
<div style="display: flex; flex-direction: column; gap: 12px;"><div style="aspect-ratio: 4 / 3; border-radius: 4px; overflow: hidden; background: var(--slot);"><img alt={L("A crew leader on the phone beside a mason laying bricks on scaffolding", "ভারায় ইট গাঁথা রাজমিস্ত্রির পাশে ফোনে কথা বলছেন একজন দলনেতা")} src="/images/pexels-12709122-w900.webp" style="width: 100%; height: 100%; object-fit: cover; object-position: center center; display: block;"/></div><h3 class="heading-4" style="margin: 0px; color: var(--indigo); font-size: 22px;">{L("Team Leaders", "টিম লিডার")} <span lang="bn" style='font-family: "Anek Bangla", sans-serif; color: var(--orange-ink); font-weight: 500;'>টিম লিডার</span></h3><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("Lead a crew people can trust.", "এমন দল চালান, যার ওপর মানুষ ভরসা করে।")}</p></div>
<div style="display: flex; flex-direction: column; gap: 12px;"><div style="aspect-ratio: 4 / 3; border-radius: 4px; overflow: hidden; background: var(--slot);"><img alt={L("Two engineers in safety helmets reviewing construction plans on site", "সাইটে হেলমেট পরে নির্মাণ নকশা দেখছেন দুজন প্রকৌশলী")} src="/images/pexels-1216589-w900.webp" style="width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block;"/></div><h3 class="heading-4" style="margin: 0px; color: var(--indigo); font-size: 22px;">{L("Clients", "ক্লায়েন্ট")}</h3><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("Need a crew? Hire people you can trust.", "দল দরকার? বিশ্বস্ত মানুষ নিন।")}</p></div>
<div style="display: flex; flex-direction: column; gap: 12px;"><div style="aspect-ratio: 4 / 3; border-radius: 4px; overflow: hidden; background: var(--slot);"><img alt={L("A worker repairing public power lines from a ladder", "মই থেকে সরকারি বিদ্যুৎ লাইন মেরামত করছেন একজন কর্মী")} src="/images/pexels-14934022-w900.webp" style="width: 100%; height: 100%; object-fit: cover; object-position: center center; display: block;"/></div><h3 class="heading-4" style="margin: 0px; color: var(--indigo); font-size: 22px;">{L("Government and public works", "সরকারি ও গণপূর্ত কাজ")}</h3><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("Organised, recorded crews for public work.", "সরকারি কাজের জন্য সংগঠিত, রেকর্ডভুক্ত দল।")}</p></div>
</div>
</div></section><section data-screen-label="Values" data-theme="light" style="background: var(--paper); padding-block: 72px;">
<div class="k-container">
<h2 style='margin: 0px 0px 8px; font: 700 clamp(30px, 3vw, 42px) / 1.1 Ubuntu, "Trebuchet MS", sans-serif; letter-spacing: -1px; color: var(--indigo); text-align: center;'>{L("What we stand for", "আমরা যার পক্ষে")}</h2>
<p class="small" style="margin: 0px 0px 32px; color: var(--ink-muted); text-align: center;">{L("Bangla names to be checked by a native speaker.", "বাংলা নামগুলো একজন মাতৃভাষী যাচাই করবেন।")}</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 28px 40px;">
<div style="border-top: 1px solid var(--line); padding-top: 16px; display: flex; flex-direction: column; gap: 6px;"><h3 class="heading-4" style="margin: 0px; color: var(--indigo); font-size: 22px;">{L("Economic visibility", "অর্থনৈতিক দৃশ্যমানতা")}</h3><p lang="bn" style='margin: 0px; font: 500 17px / 1.6 "Anek Bangla", sans-serif; color: var(--orange-ink);'>অর্থনৈতিক দৃশ্যমানতা</p><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("Work that is counted can be valued.", "যে কাজ গোনা হয়, তার মূল্যও দেওয়া যায়।")}</p></div>
<div style="border-top: 1px solid var(--line); padding-top: 16px; display: flex; flex-direction: column; gap: 6px;"><h3 class="heading-4" style="margin: 0px; color: var(--indigo); font-size: 22px;">{L("Infrastructure", "অবকাঠামো")}</h3><p lang="bn" style='margin: 0px; font: 500 17px / 1.6 "Anek Bangla", sans-serif; color: var(--orange-ink);'>অবকাঠামো</p><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("A record others can build on, like a road.", "রাস্তার মতো একটি রেকর্ড, যার ওপর অন্যরাও গড়তে পারে।")}</p></div>
<div style="border-top: 1px solid var(--line); padding-top: 16px; display: flex; flex-direction: column; gap: 6px;"><h3 class="heading-4" style="margin: 0px; color: var(--indigo); font-size: 22px;">{L("Dignity and empowerment", "মর্যাদা ও ক্ষমতায়ন")}</h3><p lang="bn" style='margin: 0px; font: 500 17px / 1.6 "Anek Bangla", sans-serif; color: var(--orange-ink);'>মর্যাদা ও ক্ষমতায়ন</p><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("Workers are capable people with work to show.", "কর্মীরা দক্ষ মানুষ, দেখানোর মতো কাজ তাদের আছে।")}</p></div>
<div style="border-top: 1px solid var(--line); padding-top: 16px; display: flex; flex-direction: column; gap: 6px;"><h3 class="heading-4" style="margin: 0px; color: var(--indigo); font-size: 22px;">{L("Accountability", "জবাবদিহি")}</h3><p lang="bn" style='margin: 0px; font: 500 17px / 1.6 "Anek Bangla", sans-serif; color: var(--orange-ink);'>জবাবদিহিতা</p><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("Everyone on the job answers for their part.", "কাজের সঙ্গে যুক্ত প্রত্যেকে নিজের অংশের দায় নেন।")}</p></div>
<div style="border-top: 1px solid var(--line); padding-top: 16px; display: flex; flex-direction: column; gap: 6px;"><h3 class="heading-4" style="margin: 0px; color: var(--indigo); font-size: 22px;">{L("Impact", "প্রভাব")}</h3><p lang="bn" style='margin: 0px; font: 500 17px / 1.6 "Anek Bangla", sans-serif; color: var(--orange-ink);'>প্রভাব</p><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("We measure ourselves by what changes for workers.", "কর্মীদের জীবনে কী বদলাল, তা দিয়েই আমরা নিজেদের মাপি।")}</p></div>
<div style="border-top: 1px solid var(--line); padding-top: 16px; display: flex; flex-direction: column; gap: 6px;"><h3 class="heading-4" style="margin: 0px; color: var(--indigo); font-size: 22px;">{L("Cooperative", "সমবায়")}</h3><p lang="bn" style='margin: 0px; font: 500 17px / 1.6 "Anek Bangla", sans-serif; color: var(--orange-ink);'>সমবায়</p><p class="body" style="margin: 0px; color: var(--ink-muted);">{L("Built together, with everyone who makes the work happen.", "যারা কাজটা ঘটান, সবাইকে নিয়ে একসঙ্গে গড়া।")}</p></div>
</div>
</div></section><section data-screen-label="The mark" data-theme="light" style="background: rgb(255, 255, 255); padding-block: 72px;">
<div class="k-container">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px 64px; align-items: center;">
<div style="display: flex; align-items: center; justify-content: center; gap: 32px;">
<img alt={L("The Kormik mark: a raised fist with a spiral", "কর্মীকের প্রতীক: সর্পিল রেখাসহ উঁচু করা মুষ্টি")} src="/brand/kormik-mark-orange.png" style="width: 180px; height: auto; display: block;"/>
<div aria-hidden="true" style="width: 110px; aspect-ratio: 502 / 689; background: var(--indigo); mask-image: url(/images/fingerprint.webp); mask-size: contain; mask-repeat: no-repeat;"></div>
</div>
<div style="display: flex; flex-direction: column; gap: 16px;">
<h2 style='margin: 0px; font: 700 clamp(30px, 3vw, 42px) / 1.1 Ubuntu, "Trebuchet MS", sans-serif; letter-spacing: -1px; color: var(--indigo);'>{L("The mark", "প্রতীক")}</h2>
<p class="body-lg" style="margin: 0px; color: var(--ink);">{L("A raised fist for the hard-working people who build Bangladesh, finally getting the recognition their work has earned. In its palm, a spiral drawn from a fingerprint: a record that is yours, and no one else's.", "উঁচু করা মুষ্টি, বাংলাদেশ গড়া পরিশ্রমী মানুষদের জন্য, যারা অবশেষে তাদের কাজের প্রাপ্য স্বীকৃতি পাচ্ছেন। হাতের তালুতে আঙুলের ছাপ থেকে নেওয়া একটি সর্পিল রেখা: একটি রেকর্ড, যা শুধু আপনার।")}</p>
</div>
</div>
</div></section><section data-screen-label="Where we are" data-theme="indigo" id="where-we-are" style="background: var(--indigo-deep); color: rgb(255, 255, 255); padding-block: 72px;">
<div class="k-container">
<h2 style='margin: 0px 0px 40px; font: 700 clamp(30px, 3vw, 42px) / 1.1 Ubuntu, "Trebuchet MS", sans-serif; letter-spacing: -1px; color: rgb(255, 255, 255); text-align: center;'>{L("Where we are", "আমরা এখন কোথায়")}</h2>
<ol style="list-style: none; margin: 0px; padding: 0px; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 28px 20px;">
<li style="display: flex; flex-direction: column; gap: 12px;"><div style="display: flex; align-items: center; gap: 8px;"><span style="width: 16px; height: 16px; border-radius: 999px; background: var(--orange); flex: 0 0 auto;"></span><span style="flex: 1 1 0%; border-top: 2px solid var(--orange);"></span></div><p class="label" style="margin: 0px; color: var(--orange);">{L("Done", "সম্পন্ন")}</p><h3 class="heading-4" style="margin: 0px; color: rgb(255, 255, 255); font-size: 24px;">{L("Prototype", "প্রোটোটাইপ")}</h3></li>
<li style="display: flex; flex-direction: column; gap: 12px;"><div style="display: flex; align-items: center; gap: 8px;"><span style="width: 16px; height: 16px; border-radius: 999px; background: rgb(255, 255, 255); box-shadow: 0 0 0 4px var(--orange); flex: 0 0 auto;"></span><span style="flex: 1 1 0%; border-top: 2px dashed var(--lavender-dim);"></span></div><p class="label" style="margin: 0px; color: var(--orange);">{L("Now", "এখন")}</p><h3 class="heading-4" style="margin: 0px; color: rgb(255, 255, 255); font-size: 24px;">{L("Field testing", "মাঠপর্যায়ে পরীক্ষা")}</h3></li>
<li style="display: flex; flex-direction: column; gap: 12px;"><div style="display: flex; align-items: center; gap: 8px;"><span style="width: 16px; height: 16px; border-radius: 999px; border: 2px solid var(--lavender-dim); box-sizing: border-box; flex: 0 0 auto;"></span><span style="flex: 1 1 0%; border-top: 2px dashed var(--lavender-dim);"></span></div><p class="label" style="margin: 0px; color: var(--lavender-dim);">{L("Next", "এরপর")}</p><h3 class="heading-4" style="margin: 0px; color: var(--lavender); font-size: 24px;">{L("First version", "প্রথম সংস্করণ")}</h3></li>
<li style="display: flex; flex-direction: column; gap: 12px;"><div style="display: flex; align-items: center; gap: 8px;"><span style="width: 16px; height: 16px; border-radius: 999px; border: 2px solid var(--lavender-dim); box-sizing: border-box; flex: 0 0 auto;"></span></div><p class="label" style="margin: 0px; color: var(--lavender-dim);">{L("Later", "পরে")}</p><h3 class="heading-4" style="margin: 0px; color: var(--lavender); font-size: 24px;">{L("Opening in Dhaka", "ঢাকায় চালু")}</h3></li>
</ol>
</div></section><section data-screen-label="CTA" data-theme="light" style="background: var(--paper); padding-block: 72px;">
<div class="k-container" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px;">
<h2 style='margin: 0px; font: 700 clamp(30px, 3vw, 42px) / 1.1 Ubuntu, "Trebuchet MS", sans-serif; letter-spacing: -1px; color: var(--indigo);'>{L("Be there when Kormik opens.", "কর্মীক চালুর দিনে থাকুন।")}</h2>
<div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;">
<a class="k-btn k-btn--primary k-btn--md" href={href("/join")}>{L("Join early access", "আগাম নিবন্ধন করুন")}<span aria-hidden="true" class="k-btn__arrow">→</span></a>
<a class="k-btn k-btn--secondary k-btn--md" href={href("/join#contact")}>{L("Get in touch", "যোগাযোগ করুন")}</a>
</div>
</div></section></main>
