---
import { PAGES, localize, type Lang, type PageKey } from '../lib/i18n';

interface Props { lang: Lang; active?: PageKey; path: string }
const { lang, active, path } = Astro.props;
const bn = lang === 'bn';
const logo = bn ? '/brand/kormik-bangla-orange-indigo.png' : '/brand/kormik-lockup-orange-indigo.png';
const enHref = path;
const bnHref = localize(path, 'bn');
---
<header class="k-nav" data-theme="light" data-nav>
  <div class="k-nav__inner">
    <a class="k-nav__logo" href={localize('/', lang)}><img alt={bn ? 'কর্মীক' : 'Kormik'} height="40" src={logo} /></a>
    <nav aria-label={bn ? 'প্রধান মেনু' : 'Main'} class="k-nav__links" id="k-nav-links">
      {PAGES.map((p) => (
        <a
          aria-current={p.key === active ? 'page' : undefined}
          class={p.key === active ? 'k-nav__link is-active' : 'k-nav__link'}
          href={localize(p.path, lang)}
        >{bn ? p.bn : p.en}</a>
      ))}
      <a class="k-btn k-btn--primary k-btn--md k-nav__cta-m" href={localize('/join', lang)}>{bn ? 'আগাম নিবন্ধন করুন' : 'Get early access'}<span aria-hidden="true" class="k-btn__arrow">→</span></a>
    </nav>
    <div class="k-nav__end">
      <div aria-label={bn ? 'ভাষা' : 'Language'} class="k-lang" role="group">
        <button aria-pressed={bn ? 'false' : 'true'} class={bn ? 'k-lang__opt' : 'k-lang__opt is-active'} type="button" data-lang-href={enHref} lang="en">EN</button>
        <button aria-pressed={bn ? 'true' : 'false'} class={bn ? 'k-lang__opt is-active' : 'k-lang__opt'} lang="bn" type="button" data-lang-href={bnHref}>বাং</button>
      </div>
      <a class="k-btn k-btn--primary k-btn--sm" href={localize('/join', lang)}>{bn ? 'আগাম নিবন্ধন' : 'Get early access'}</a>
      <button aria-controls="k-nav-links" aria-expanded="false" class="k-nav__menu" type="button" data-menu data-open-label={bn ? 'বন্ধ' : 'Close'} data-closed-label={bn ? 'মেনু' : 'Menu'}><span class="k-nav__burger" aria-hidden="true"><i></i><i></i><i></i></span><span class="k-nav__menu-label">{bn ? 'মেনু' : 'Menu'}</span></button>
    </div>
  </div>
</header>
