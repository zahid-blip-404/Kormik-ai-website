---
import Base from '../layouts/Base.astro';
---
<Base lang="en" path="/" title="Page not found · Kormik" description="This page does not exist.">
  <main>
    <section data-theme="indigo" style="background: var(--indigo); color: #fff; padding-block: 120px;">
      <div class="k-container" style="display: flex; flex-direction: column; gap: 20px; align-items: flex-start;">
        <p class="label" style="margin: 0; color: var(--lavender);">404</p>
        <h1 style="margin: 0; font: 700 clamp(34px, 3.6vw, 52px)/1.08 Ubuntu, 'Anek Bangla', sans-serif; letter-spacing: -1.2px; color: #fff;">This page isn't on record. <span style="color: var(--orange);" lang="bn">পাতাটি পাওয়া যায়নি।</span></h1>
        <p class="body-lg" style="margin: 0; color: var(--lavender); max-width: 46ch;">The link may be old or mistyped.</p>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <a class="k-btn k-btn--primary k-btn--lg" href="/">Go to the home page<span aria-hidden="true" class="k-btn__arrow">→</span></a>
          <a class="k-btn k-btn--secondary k-btn--lg" href="/bn">বাংলা হোম</a>
        </div>
      </div>
    </section>
  </main>
</Base>
