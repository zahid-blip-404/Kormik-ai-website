{"title":"About · Kormik","styles":"\n    .sc-placeholder{background:color-mix(in srgb,currentColor 8%,transparent);\n      border:1px solid color-mix(in srgb,currentColor 50%,transparent);\n      border-radius:2px;box-sizing:border-box;overflow:hidden}\n    @keyframes sc-shine{0%{background-position:100% 50%}100%{background-position:0% 50%}}\n    html.sc-dc-streaming .sc-placeholder,\n    html.sc-dc-streaming .sc-interp.sc-missing{position:relative;\n      background:color-mix(in srgb,currentColor 5%,transparent);\n      border-color:transparent}\n    html.sc-dc-streaming .sc-placeholder::before,\n    html.sc-dc-streaming .sc-interp.sc-missing::before{content:'';\n      position:absolute;inset:0;pointer-events:none;\n      background:linear-gradient(90deg,rgba(217,119,87,0) 25%,rgba(247,225,211,.95) 37%,rgba(217,119,87,0) 63%);\n      background-size:400% 100%;animation:sc-shine 1.4s ease infinite}\n    html.sc-dc-streaming .sc-placeholder:nth-child(n+9 of .sc-placeholder)::before,\n    html.sc-dc-streaming .sc-interp.sc-missing:nth-child(n+9 of .sc-interp.sc-missing)::before{animation:none;\n      background:color-mix(in srgb,currentColor 8%,transparent)}\n    .sc-placeholder-error{padding:4px 8px;font:11px/1.4 ui-monospace,monospace;\n      color:color-mix(in srgb,currentColor 70%,transparent);word-break:break-word}\n    .sc-interp.sc-missing{display:inline-block;width:2em;height:1em;overflow:hidden;\n      vertical-align:text-bottom;background:rgba(255,255,255,.3);border:1px solid rgba(0,0,0,.5);\n      border-radius:2px;box-sizing:border-box;color:transparent;\n      user-select:none}\n    .sc-interp.sc-unresolved{font-family:ui-monospace,monospace;font-size:.85em;\n      color:color-mix(in srgb,currentColor 50%,transparent);\n      background:color-mix(in srgb,currentColor 10%,transparent);border-radius:3px;\n      padding:0 3px}\n    .sc-host.sc-has-error{position:relative}\n    .sc-logic-error{position:absolute;top:8px;left:8px;z-index:2147483647;max-width:60ch;\n      padding:6px 10px;background:#b00020;color:#fff;font:12px/1.4 ui-monospace,monospace;\n      border-radius:4px;white-space:pre-wrap;pointer-events:none}\n    /* Mirrors PRINT_BASELINE_CSS in apps/web deck-stage-export.ts — keep both\n       in sync until dc-runtime regains a build step. */\n    @media print {\n      @page { margin: 0.5cm; }\n      figure, table { break-inside: avoid; }\n      #dc-root, #dc-root > .sc-host { height: auto; }\n      *, *::before, *::after {\n        print-color-adjust: exact; -webkit-print-color-adjust: exact;\n        backdrop-filter: none !important; -webkit-backdrop-filter: none !important;\n        animation-delay: -99s !important; animation-duration: .001s !important;\n        animation-iteration-count: 1 !important; animation-fill-mode: both !important;\n        animation-play-state: running !important; transition-duration: 0s !important;\n      }\n    }\n  \n/* ---- */\nx-dc{display:none!important}\n/* ---- */\nhtml,body{height:100%;margin:0}#dc-root,#dc-root>.sc-host{height:100%}\n/* ---- */\n\n    html { scroll-behavior: smooth; }\n    body { margin: 0; background: var(--paper); }\n    a { color: var(--indigo); text-decoration-color: var(--orange); }\n    a:hover { color: var(--indigo); }\n    @media (max-width: 768px) { .k-nav__menu, .k-lang__opt, .k-chip { min-height: 44px; } .k-btn--link { min-height: 44px; display: inline-flex; } }\n  ","html":"<div class=\"sc-host\" data-sc-name=\"About\"><div class=\"sc-host-x\" data-dc-tpl=\"12\" style=\"display: contents;\"><header class=\"k-nav\" data-theme=\"light\"><div class=\"k-nav__inner\"><a href=\"Home.dc.html\" class=\"k-nav__logo\"><img src=\"assets/logos/kormik-lockup-orange-indigo.png\" alt=\"Kormik\" height=\"40\"></a><nav class=\"k-nav__links\" aria-label=\"Main\"><a href=\"Home.dc.html\" class=\"k-nav__link\">Home</a><a href=\"Why it matters.dc.html\" class=\"k-nav__link\">Why it matters</a><a href=\"For clients.dc.html\" class=\"k-nav__link\">For clients</a><a href=\"Approach.dc.html\" class=\"k-nav__link\">Approach</a><a href=\"About.dc.html\" class=\"k-nav__link is-active\" aria-current=\"page\">About</a><a href=\"Join.dc.html\" class=\"k-nav__link\">Join</a></nav><div class=\"k-nav__end\"><div class=\"k-lang\" role=\"group\" aria-label=\"Language\"><button type=\"button\" class=\"k-lang__opt is-active\" aria-pressed=\"true\">EN</button><button type=\"button\" lang=\"bn\" class=\"k-lang__opt\" aria-pressed=\"false\">বাং</button></div><a href=\"Join.dc.html\" class=\"k-btn k-btn--primary k-btn--sm\">Get early access</a><button type=\"button\" class=\"k-nav__menu\" aria-expanded=\"false\">Menu</button></div></div></header></div><main data-dc-tpl=\"13\"><section data-dc-tpl=\"14\" data-theme=\"light\" data-screen-label=\"The name\" style=\"background: var(--paper); padding-block: 64px; overflow: hidden;\">\n  <div data-dc-tpl=\"15\" class=\"k-container\">\n    <div data-dc-tpl=\"16\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px 64px; align-items: center;\">\n      <div data-dc-tpl=\"17\" style=\"min-width: 0px;\">\n        <p data-dc-tpl=\"18\" lang=\"bn\" style=\"margin: 0px; font: 700 clamp(140px, 17vw, 260px) / 1.1 &quot;Anek Bangla&quot;, sans-serif; color: var(--indigo); letter-spacing: -4px;\">কর্মী</p>\n        <p data-dc-tpl=\"19\" style=\"margin: 0px; font: 500 clamp(22px, 2vw, 28px) / 1.3 Ubuntu, sans-serif; color: var(--ink-muted);\"><span data-dc-tpl=\"20\" style=\"color: var(--orange-ink);\">kormi</span> · \"worker\"</p>\n      </div>\n      <div data-dc-tpl=\"21\" style=\"display: flex; flex-direction: column; gap: 18px;\">\n        <p data-dc-tpl=\"22\" class=\"label\" style=\"margin: 0px; color: var(--ink-muted);\">About Kormik</p>\n        <h1 data-dc-tpl=\"23\" style=\"margin: 0px; font: 700 clamp(32px, 3.2vw, 46px) / 1.1 Ubuntu, &quot;Trebuchet MS&quot;, sans-serif; letter-spacing: -1.2px; color: var(--indigo);\">Kormik is named for the people who do the work.</h1>\n        <p data-dc-tpl=\"24\" class=\"body-lg\" style=\"margin: 0px; color: var(--ink);\">Masons, painters, electricians, helpers, loaders. The people who build Bangladesh, and who have never had a record of it.</p>\n      </div>\n    </div>\n  </div></section><section data-dc-tpl=\"25\" data-theme=\"indigo\" data-screen-label=\"Mission\" style=\"background: var(--indigo); color: rgb(255, 255, 255); padding-block: 88px;\">\n  <div data-dc-tpl=\"26\" class=\"k-container\" style=\"display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px;\">\n    <p data-dc-tpl=\"27\" class=\"label\" style=\"margin: 0px; color: var(--lavender);\">Our mission</p>\n    <h2 data-dc-tpl=\"28\" style=\"margin: 0px; font: 700 clamp(32px, 3.8vw, 56px) / 1.08 Ubuntu, &quot;Trebuchet MS&quot;, sans-serif; letter-spacing: -1.4px; color: rgb(255, 255, 255);\">Every day of informal work in Bangladesh, <span data-dc-tpl=\"29\" style=\"color: var(--orange);\">recognised, paid and protected.</span></h2>\n  </div></section><section data-dc-tpl=\"30\" data-theme=\"light\" data-screen-label=\"Who we build for\" style=\"background: rgb(255, 255, 255); padding-block: 72px;\">\n  <div data-dc-tpl=\"31\" class=\"k-container\">\n    <h2 data-dc-tpl=\"32\" style=\"margin: 0px 0px 36px; font: 700 clamp(30px, 3vw, 42px) / 1.1 Ubuntu, &quot;Trebuchet MS&quot;, sans-serif; letter-spacing: -1px; color: var(--indigo); text-align: center;\">Who we're building for</h2>\n    <div data-dc-tpl=\"33\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px 24px;\">\n      <div data-dc-tpl=\"34\" style=\"display: flex; flex-direction: column; gap: 12px;\"><div data-dc-tpl=\"35\" style=\"aspect-ratio: 4 / 3; border-radius: 4px; overflow: hidden; background: var(--slot);\"><img data-dc-tpl=\"36\" src=\"https://images.pexels.com/photos/37556467/pexels-photo-37556467.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900\" alt=\"A construction worker in a safety vest and headscarf holding a spade\" style=\"width: 100%; height: 100%; object-fit: cover; object-position: center 25%; display: block;\"></div><h3 data-dc-tpl=\"37\" class=\"heading-4\" style=\"margin: 0px; color: var(--indigo); font-size: 22px;\">Workers <span data-dc-tpl=\"38\" lang=\"bn\" style=\"font-family: &quot;Anek Bangla&quot;, sans-serif; color: var(--orange-ink); font-weight: 500;\">কর্মী</span></h3><p data-dc-tpl=\"39\" class=\"body\" style=\"margin: 0px; color: var(--ink-muted);\">Your work, on record.</p></div>\n      <div data-dc-tpl=\"40\" style=\"display: flex; flex-direction: column; gap: 12px;\"><div data-dc-tpl=\"41\" style=\"aspect-ratio: 4 / 3; border-radius: 4px; overflow: hidden; background: var(--slot);\"><img data-dc-tpl=\"42\" src=\"https://images.pexels.com/photos/12709122/pexels-photo-12709122.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900\" alt=\"A crew leader on the phone beside a mason laying bricks on scaffolding\" style=\"width: 100%; height: 100%; object-fit: cover; object-position: center center; display: block;\"></div><h3 data-dc-tpl=\"43\" class=\"heading-4\" style=\"margin: 0px; color: var(--indigo); font-size: 22px;\">Team Leaders <span data-dc-tpl=\"44\" lang=\"bn\" style=\"font-family: &quot;Anek Bangla&quot;, sans-serif; color: var(--orange-ink); font-weight: 500;\">টিম লিডার</span></h3><p data-dc-tpl=\"45\" class=\"body\" style=\"margin: 0px; color: var(--ink-muted);\">Lead a crew people can trust.</p></div>\n      <div data-dc-tpl=\"46\" style=\"display: flex; flex-direction: column; gap: 12px;\"><div data-dc-tpl=\"47\" style=\"aspect-ratio: 4 / 3; border-radius: 4px; overflow: hidden; background: var(--slot);\"><img data-dc-tpl=\"48\" src=\"https://images.pexels.com/photos/1216589/pexels-photo-1216589.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900\" alt=\"Two engineers in safety helmets reviewing construction plans on site\" style=\"width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block;\"></div><h3 data-dc-tpl=\"49\" class=\"heading-4\" style=\"margin: 0px; color: var(--indigo); font-size: 22px;\">Clients</h3><p data-dc-tpl=\"50\" class=\"body\" style=\"margin: 0px; color: var(--ink-muted);\">Need a crew? Hire people you can trust.</p></div>\n      <div data-dc-tpl=\"51\" style=\"display: flex; flex-direction: column; gap: 12px;\"><div data-dc-tpl=\"52\" style=\"aspect-ratio: 4 / 3; border-radius: 4px; overflow: hidden; background: var(--slot);\"><img data-dc-tpl=\"53\" src=\"https://images.pexels.com/photos/14934022/pexels-photo-14934022.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=900\" alt=\"A worker repairing public power lines from a ladder\" style=\"width: 100%; height: 100%; object-fit: cover; object-position: center center; display: block;\"></div><h3 data-dc-tpl=\"54\" class=\"heading-4\" style=\"margin: 0px; color: var(--indigo); font-size: 22px;\">Government and public works</h3><p data-dc-tpl=\"55\" class=\"body\" style=\"margin: 0px; color: var(--ink-muted);\">Organised, recorded crews for public work.</p></div>\n    </div>\n  </div></section><section data-dc-tpl=\"56\" data-theme=\"light\" data-screen-label=\"Values\" style=\"background: var(--paper); padding-block: 72px;\">\n  <div data-dc-tpl=\"57\" class=\"k-container\">\n    <h2 data-dc-tpl=\"58\" style=\"margin: 0px 0px 8px; font: 700 clamp(30px, 3vw, 42px) / 1.1 Ubuntu, &quot;Trebuchet MS&quot;, sans-serif; letter-spacing: -1px; color: var(--indigo); text-align: center;\">What we stand for</h2>\n    <p data-dc-tpl=\"59\" class=\"small\" style=\"margin: 0px 0px 32px; color: var(--ink-muted); text-align: center;\">Bangla names to be checked by a native speaker.</p>\n    <div data-dc-tpl=\"60\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 28px 40px;\">\n      <div data-dc-tpl=\"61\" style=\"border-top: 1px solid var(--line); padding-top: 16px; display: flex; flex-direction: column; gap: 6px;\"><h3 data-dc-tpl=\"62\" class=\"heading-4\" style=\"margin: 0px; color: var(--indigo); font-size: 22px;\">Economic visibility</h3><p data-dc-tpl=\"63\" lang=\"bn\" style=\"margin: 0px; font: 500 17px / 1.6 &quot;Anek Bangla&quot;, sans-serif; color: var(--orange-ink);\">অর্থনৈতিক দৃশ্যমানতা</p><p data-dc-tpl=\"64\" class=\"body\" style=\"margin: 0px; color: var(--ink-muted);\">Work that is counted can be valued.</p></div>\n      <div data-dc-tpl=\"65\" style=\"border-top: 1px solid var(--line); padding-top: 16px; display: flex; flex-direction: column; gap: 6px;\"><h3 data-dc-tpl=\"66\" class=\"heading-4\" style=\"margin: 0px; color: var(--indigo); font-size: 22px;\">Infrastructure</h3><p data-dc-tpl=\"67\" lang=\"bn\" style=\"margin: 0px; font: 500 17px / 1.6 &quot;Anek Bangla&quot;, sans-serif; color: var(--orange-ink);\">অবকাঠামো</p><p data-dc-tpl=\"68\" class=\"body\" style=\"margin: 0px; color: var(--ink-muted);\">A record others can build on, like a road.</p></div>\n      <div data-dc-tpl=\"69\" style=\"border-top: 1px solid var(--line); padding-top: 16px; display: flex; flex-direction: column; gap: 6px;\"><h3 data-dc-tpl=\"70\" class=\"heading-4\" style=\"margin: 0px; color: var(--indigo); font-size: 22px;\">Dignity and empowerment</h3><p data-dc-tpl=\"71\" lang=\"bn\" style=\"margin: 0px; font: 500 17px / 1.6 &quot;Anek Bangla&quot;, sans-serif; color: var(--orange-ink);\">মর্যাদা ও ক্ষমতায়ন</p><p data-dc-tpl=\"72\" class=\"body\" style=\"margin: 0px; color: var(--ink-muted);\">Workers are capable people with work to show.</p></div>\n      <div data-dc-tpl=\"73\" style=\"border-top: 1px solid var(--line); padding-top: 16px; display: flex; flex-direction: column; gap: 6px;\"><h3 data-dc-tpl=\"74\" class=\"heading-4\" style=\"margin: 0px; color: var(--indigo); font-size: 22px;\">Accountability</h3><p data-dc-tpl=\"75\" lang=\"bn\" style=\"margin: 0px; font: 500 17px / 1.6 &quot;Anek Bangla&quot;, sans-serif; color: var(--orange-ink);\">জবাবদিহিতা</p><p data-dc-tpl=\"76\" class=\"body\" style=\"margin: 0px; color: var(--ink-muted);\">Everyone on the job answers for their part.</p></div>\n      <div data-dc-tpl=\"77\" style=\"border-top: 1px solid var(--line); padding-top: 16px; display: flex; flex-direction: column; gap: 6px;\"><h3 data-dc-tpl=\"78\" class=\"heading-4\" style=\"margin: 0px; color: var(--indigo); font-size: 22px;\">Impact</h3><p data-dc-tpl=\"79\" lang=\"bn\" style=\"margin: 0px; font: 500 17px / 1.6 &quot;Anek Bangla&quot;, sans-serif; color: var(--orange-ink);\">প্রভাব</p><p data-dc-tpl=\"80\" class=\"body\" style=\"margin: 0px; color: var(--ink-muted);\">We measure ourselves by what changes for workers.</p></div>\n      <div data-dc-tpl=\"81\" style=\"border-top: 1px solid var(--line); padding-top: 16px; display: flex; flex-direction: column; gap: 6px;\"><h3 data-dc-tpl=\"82\" class=\"heading-4\" style=\"margin: 0px; color: var(--indigo); font-size: 22px;\">Cooperative</h3><p data-dc-tpl=\"83\" lang=\"bn\" style=\"margin: 0px; font: 500 17px / 1.6 &quot;Anek Bangla&quot;, sans-serif; color: var(--orange-ink);\">সমবায়</p><p data-dc-tpl=\"84\" class=\"body\" style=\"margin: 0px; color: var(--ink-muted);\">Built together, with everyone who makes the work happen.</p></div>\n    </div>\n  </div></section><section data-dc-tpl=\"85\" data-theme=\"light\" data-screen-label=\"The mark\" style=\"background: rgb(255, 255, 255); padding-block: 72px;\">\n  <div data-dc-tpl=\"86\" class=\"k-container\">\n    <div data-dc-tpl=\"87\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px 64px; align-items: center;\">\n      <div data-dc-tpl=\"88\" style=\"display: flex; align-items: center; justify-content: center; gap: 32px;\">\n        <img data-dc-tpl=\"89\" src=\"assets/logos/kormik-mark-orange.png\" alt=\"The Kormik mark: a raised fist with a spiral\" style=\"width: 180px; height: auto; display: block;\">\n        <div data-dc-tpl=\"90\" aria-hidden=\"true\" style=\"width: 110px; aspect-ratio: 502 / 689; background: var(--indigo); mask-image: url(&quot;assets/fingerprint.png&quot;); mask-size: contain; mask-repeat: no-repeat;\"></div>\n      </div>\n      <div data-dc-tpl=\"91\" style=\"display: flex; flex-direction: column; gap: 16px;\">\n        <h2 data-dc-tpl=\"92\" style=\"margin: 0px; font: 700 clamp(30px, 3vw, 42px) / 1.1 Ubuntu, &quot;Trebuchet MS&quot;, sans-serif; letter-spacing: -1px; color: var(--indigo);\">The mark</h2>\n        <p data-dc-tpl=\"93\" class=\"body-lg\" style=\"margin: 0px; color: var(--ink);\">A raised fist for the hard-working people who build Bangladesh, finally getting the recognition their work has earned. In its palm, a spiral drawn from a fingerprint: a record that is yours, and no one else's.</p>\n        \n      </div>\n    </div>\n  </div></section><section data-dc-tpl=\"94\" id=\"where-we-are\" data-theme=\"indigo\" data-screen-label=\"Where we are\" style=\"background: var(--indigo-deep); color: rgb(255, 255, 255); padding-block: 72px;\">\n  <div data-dc-tpl=\"95\" class=\"k-container\">\n    <h2 data-dc-tpl=\"96\" style=\"margin: 0px 0px 40px; font: 700 clamp(30px, 3vw, 42px) / 1.1 Ubuntu, &quot;Trebuchet MS&quot;, sans-serif; letter-spacing: -1px; color: rgb(255, 255, 255); text-align: center;\">Where we are</h2>\n    <ol data-dc-tpl=\"97\" style=\"list-style: none; margin: 0px; padding: 0px; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 28px 20px;\">\n      <li data-dc-tpl=\"98\" style=\"display: flex; flex-direction: column; gap: 12px;\"><div data-dc-tpl=\"99\" style=\"display: flex; align-items: center; gap: 8px;\"><span data-dc-tpl=\"100\" style=\"width: 16px; height: 16px; border-radius: 999px; background: var(--orange); flex: 0 0 auto;\"></span><span data-dc-tpl=\"101\" style=\"flex: 1 1 0%; border-top: 2px solid var(--orange);\"></span></div><p data-dc-tpl=\"102\" class=\"label\" style=\"margin: 0px; color: var(--orange);\">Done</p><h3 data-dc-tpl=\"103\" class=\"heading-4\" style=\"margin: 0px; color: rgb(255, 255, 255); font-size: 24px;\">Prototype</h3></li>\n      <li data-dc-tpl=\"104\" style=\"display: flex; flex-direction: column; gap: 12px;\"><div data-dc-tpl=\"105\" style=\"display: flex; align-items: center; gap: 8px;\"><span data-dc-tpl=\"106\" style=\"width: 16px; height: 16px; border-radius: 999px; background: rgb(255, 255, 255); box-shadow: 0 0 0 4px var(--orange); flex: 0 0 auto;\"></span><span data-dc-tpl=\"107\" style=\"flex: 1 1 0%; border-top: 2px dashed var(--lavender-dim);\"></span></div><p data-dc-tpl=\"108\" class=\"label\" style=\"margin: 0px; color: var(--orange);\">Now</p><h3 data-dc-tpl=\"109\" class=\"heading-4\" style=\"margin: 0px; color: rgb(255, 255, 255); font-size: 24px;\">Field testing</h3></li>\n      <li data-dc-tpl=\"110\" style=\"display: flex; flex-direction: column; gap: 12px;\"><div data-dc-tpl=\"111\" style=\"display: flex; align-items: center; gap: 8px;\"><span data-dc-tpl=\"112\" style=\"width: 16px; height: 16px; border-radius: 999px; border: 2px solid var(--lavender-dim); box-sizing: border-box; flex: 0 0 auto;\"></span><span data-dc-tpl=\"113\" style=\"flex: 1 1 0%; border-top: 2px dashed var(--lavender-dim);\"></span></div><p data-dc-tpl=\"114\" class=\"label\" style=\"margin: 0px; color: var(--lavender-dim);\">Next</p><h3 data-dc-tpl=\"115\" class=\"heading-4\" style=\"margin: 0px; color: var(--lavender); font-size: 24px;\">First version</h3></li>\n      <li data-dc-tpl=\"116\" style=\"display: flex; flex-direction: column; gap: 12px;\"><div data-dc-tpl=\"117\" style=\"display: flex; align-items: center; gap: 8px;\"><span data-dc-tpl=\"118\" style=\"width: 16px; height: 16px; border-radius: 999px; border: 2px solid var(--lavender-dim); box-sizing: border-box; flex: 0 0 auto;\"></span></div><p data-dc-tpl=\"119\" class=\"label\" style=\"margin: 0px; color: var(--lavender-dim);\">Later</p><h3 data-dc-tpl=\"120\" class=\"heading-4\" style=\"margin: 0px; color: var(--lavender); font-size: 24px;\">Opening in Dhaka</h3></li>\n    </ol>\n  </div></section><section data-dc-tpl=\"121\" data-theme=\"light\" data-screen-label=\"CTA\" style=\"background: var(--paper); padding-block: 72px;\">\n  <div data-dc-tpl=\"122\" class=\"k-container\" style=\"display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px;\">\n    <h2 data-dc-tpl=\"123\" style=\"margin: 0px; font: 700 clamp(30px, 3vw, 42px) / 1.1 Ubuntu, &quot;Trebuchet MS&quot;, sans-serif; letter-spacing: -1px; color: var(--indigo);\">Be there when Kormik opens.</h2>\n    <div data-dc-tpl=\"124\" style=\"display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;\">\n      <div class=\"sc-host-x\" data-dc-tpl=\"125\" style=\"display: contents;\"><a href=\"Join.dc.html\" class=\"k-btn k-btn--primary k-btn--md\">Join early access<span class=\"k-btn__arrow\" aria-hidden=\"true\">→</span></a></div>\n      <div class=\"sc-host-x\" data-dc-tpl=\"126\" style=\"display: contents;\"><a href=\"Join.dc.html#contact\" class=\"k-btn k-btn--secondary k-btn--md\">Get in touch</a></div>\n    </div>\n  </div></section></main><div class=\"sc-host-x\" data-dc-tpl=\"127\" style=\"display: contents;\"><footer class=\"k-footer\" data-theme=\"indigo\"><div class=\"k-container\"><div class=\"k-footer__top\"><div class=\"k-footer__brand\"><img src=\"assets/logos/kormik-lockup-white.png\" alt=\"Kormik\" height=\"36\"><p class=\"k-footer__tag\">A record that's yours. Every day of informal work in Bangladesh, recognised, paid and protected.</p></div><nav class=\"k-footer__links\" aria-label=\"Footer\"><a href=\"Home.dc.html\">Home</a><a href=\"Why it matters.dc.html\">Why it matters</a><a href=\"For clients.dc.html\">For clients</a><a href=\"Approach.dc.html\">Approach</a><a href=\"About.dc.html\">About</a><a href=\"Join.dc.html\">Join</a></nav></div><div class=\"k-footer__base\"><span>© 2026 Kormik · kormik.com.bd · Pre-launch preview, made in Dhaka. Not yet a live service.</span></div></div></footer></div></div>","links":["_ds/kormik-design-system-ae88bca0-d24a-43f7-ac25-8d943541474b/tokens/fonts.css","_ds/kormik-design-system-ae88bca0-d24a-43f7-ac25-8d943541474b/tokens/icons.css","_ds/kormik-design-system-ae88bca0-d24a-43f7-ac25-8d943541474b/tokens/colors.css","_ds/kormik-design-system-ae88bca0-d24a-43f7-ac25-8d943541474b/tokens/typography.css","_ds/kormik-design-system-ae88bca0-d24a-43f7-ac25-8d943541474b/tokens/spacing.css","_ds/kormik-design-system-ae88bca0-d24a-43f7-ac25-8d943541474b/tokens/components.css","_ds/kormik-design-system-ae88bca0-d24a-43f7-ac25-8d943541474b/styles.css"]}